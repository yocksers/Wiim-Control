<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WiimControl.App"
             Name="Wiim Control"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="White" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="White" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />

    <Style Selector="Window">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource Wc.Text}" />
      <Setter Property="Background" Value="{DynamicResource Wc.Window}" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource Wc.TextMuted}" />
    </Style>
    <Style Selector="TextBlock.dim">
      <Setter Property="Foreground" Value="{DynamicResource Wc.TextDimmer}" />
    </Style>
    <Style Selector="TextBlock.accent">
      <Setter Property="Foreground" Value="{DynamicResource Wc.AccentText}" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontSize" Value="15.5" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.device">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.small">
      <Setter Property="FontSize" Value="12.5" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource Wc.Card}" />
      <Setter Property="CornerRadius" Value="{DynamicResource Wc.RadiusCard}" />
      <Setter Property="Padding" Value="20,16" />
      <Setter Property="Margin" Value="0,0,0,14" />
    </Style>
    <Style Selector="Border.card.active">
      <Setter Property="Background" Value="{DynamicResource Wc.CardActive}" />
    </Style>
    <Style Selector="Window.artwork Border.card">
      <Setter Property="Background" Value="{DynamicResource Wc.CardGlass}" />
    </Style>
    <Style Selector="Window.artwork Border.card.active">
      <Setter Property="Background" Value="{DynamicResource Wc.CardActiveGlass}" />
    </Style>

    <Style Selector="Button.pill">
      <Setter Property="Background" Value="{DynamicResource Wc.Input}" />
      <Setter Property="Foreground" Value="{DynamicResource Wc.Text}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource Wc.RadiusPill}" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.pill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Wc.InputHover}" />
      <Setter Property="Foreground" Value="{DynamicResource Wc.Text}" />
    </Style>
    <Style Selector="Button.pill:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Wc.InputPressed}" />
    </Style>
    <Style Selector="Button.pill:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Wc.InputDisabled}" />
      <Setter Property="Foreground" Value="{DynamicResource Wc.TextDim}" />
    </Style>
    <Style Selector="Button.pill:disabled PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource Wc.TextDim}" />
    </Style>
    <Style Selector="Button.pill.accent">
      <Setter Property="Background" Value="{DynamicResource Wc.Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource Wc.OnAccent}" />
    </Style>
    <Style Selector="Button.pill.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Wc.AccentHover}" />
      <Setter Property="Foreground" Value="{DynamicResource Wc.OnAccent}" />
    </Style>

    <Style Selector="Button.pill.current">
      <Setter Property="Background" Value="{DynamicResource Wc.AccentSoft}" />
      <Setter Property="Foreground" Value="{DynamicResource Wc.AccentText}" />
    </Style>
    <Style Selector="Button.pill.current:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Wc.AccentSoftHover}" />
      <Setter Property="Foreground" Value="{DynamicResource Wc.AccentTextHover}" />
    </Style>

    <Style Selector="Button.channel">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Wc.Text}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Wc.Outline}" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="CornerRadius" Value="{DynamicResource Wc.RadiusChannel}" />
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.channel:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Wc.Input}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Wc.OutlineHover}" />
      <Setter Property="Foreground" Value="{DynamicResource Wc.Text}" />
    </Style>
    <Style Selector="Button.channel.single">
      <Setter Property="BorderBrush" Value="{DynamicResource Wc.AccentText}" />
      <Setter Property="Foreground" Value="{DynamicResource Wc.AccentText}" />
    </Style>
    <Style Selector="Button.channel.single:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource Wc.AccentTextHover}" />
      <Setter Property="Foreground" Value="{DynamicResource Wc.AccentTextHover}" />
    </Style>
    <Style Selector="Button.channel:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource Wc.InputPressed}" />
      <Setter Property="Foreground" Value="{DynamicResource Wc.TextDim}" />
    </Style>

    <Style Selector="Button.icon">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Wc.Text}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Wc.InputHover}" />
      <Setter Property="Foreground" Value="{DynamicResource Wc.Text}" />
    </Style>
    <Style Selector="Button.icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Wc.TextDim}" />
    </Style>
    <Style Selector="Button.icon:disabled PathIcon">
      <Setter Property="Opacity" Value="0.4" />
    </Style>

    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Wc.Text}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource Wc.RadiusNav}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Wc.NavHover}" />
      <Setter Property="Foreground" Value="{DynamicResource Wc.Text}" />
    </Style>
    <Style Selector="Button.nav.selected">
      <Setter Property="Background" Value="{DynamicResource Wc.NavSelected}" />
    </Style>
    <Style Selector="Button.nav.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Wc.NavSelectedHover}" />
    </Style>

    <Style Selector="ScrollViewer.menu /template/ ScrollBar">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ScrollViewer.menu:pointerover /template/ ScrollBar">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Border.navgroup">
      <Setter Property="Background" Value="{DynamicResource Wc.Card}" />
      <Setter Property="CornerRadius" Value="{DynamicResource Wc.RadiusGroup}" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
    <Style Selector="Window.artwork Border.navgroup">
      <Setter Property="Background" Value="{DynamicResource Wc.CardGlass}" />
    </Style>
    <Style Selector="Border.navseparator">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{DynamicResource Wc.Input}" />
      <Setter Property="Margin" Value="52,0,0,0" />
    </Style>
    <Style Selector="Border.navgroup Button.nav">
      <Setter Property="Margin" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Border.navgroup Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Wc.GroupHover}" />
    </Style>
    <Style Selector="Border.navgroup Button.nav.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Wc.NavSelectedHover}" />
    </Style>

    <Style Selector="Border.segments">
      <Setter Property="Background" Value="{DynamicResource Wc.Sidebar}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Wc.GroupHover}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Wc.RadiusSegments}" />
      <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="Button.segment">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Wc.SegmentText}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource Wc.RadiusSegment}" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.segment /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.18" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.segment:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Wc.SegmentText}" />
    </Style>
    <Style Selector="Button.segment.selected">
      <Setter Property="Background" Value="{DynamicResource Wc.AccentSoft}" />
      <Setter Property="Foreground" Value="{DynamicResource Wc.AccentText}" />
    </Style>
    <Style Selector="Button.segment.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Wc.AccentSoftHover}" />
      <Setter Property="Foreground" Value="{DynamicResource Wc.AccentTextHover}" />
    </Style>
    <Style Selector="Button.segment:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Wc.TextDim}" />
    </Style>
    <Style Selector="Button.segment.selected:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Wc.AccentSoftDisabled}" />
      <Setter Property="Foreground" Value="{DynamicResource Wc.AccentTextDisabled}" />
    </Style>
    <Style Selector="Button.segment.solid.selected">
      <Setter Property="Background" Value="{DynamicResource Wc.Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource Wc.OnAccent}" />
    </Style>
    <Style Selector="Button.segment.solid.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Wc.AccentHover}" />
      <Setter Property="Foreground" Value="{DynamicResource Wc.OnAccent}" />
    </Style>
    <Style Selector="Border.segment-thumb">
      <Setter Property="Background" Value="{DynamicResource Wc.Accent}" />
      <Setter Property="CornerRadius" Value="{DynamicResource Wc.RadiusSegment}" />
    </Style>
    <Style Selector="Border.segment-thumb.dim">
      <Setter Property="Background" Value="{DynamicResource Wc.AccentSoftDisabled}" />
    </Style>
    <Style Selector="Border.sliding Button.segment.selected">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Wc.OnAccent}" />
    </Style>
    <Style Selector="Border.sliding Button.segment.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Wc.OnAccent}" />
    </Style>
    <Style Selector="Border.sliding Button.segment.selected:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Wc.AccentTextDisabled}" />
    </Style>
    <Style Selector="Button.segment:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Wc.SegmentText}" />
    </Style>
    <Style Selector="Border.sliding Button.segment.selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Wc.OnAccent}" />
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{DynamicResource Wc.Input}" />
      <Setter Property="Foreground" Value="{DynamicResource Wc.Text}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource Wc.RadiusField}" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="MinHeight" Value="38" />
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#Background">
      <Setter Property="Background" Value="{DynamicResource Wc.InputHover}" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource Wc.Input}" />
      <Setter Property="Foreground" Value="{DynamicResource Wc.Text}" />
      <Setter Property="CornerRadius" Value="{DynamicResource Wc.RadiusField}" />
    </Style>

    <Style Selector="ToggleSwitch">
      <Setter Property="OnContent" Value="{x:Null}" />
      <Setter Property="OffContent" Value="{x:Null}" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Margin" Value="0,0,-12,0" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.section">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.section:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.section:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.section PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource Wc.TextMuted}" />
    </Style>
    <Style Selector="Button.section:pointerover TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Wc.Text}" />
    </Style>
    <Style Selector="Button.section:pointerover PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource Wc.Text}" />
    </Style>
  </Application.Styles>
</Application>
